{
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "buildCommand": "bun run build",
  "outputDirectory": "dist",
  "installCommand": "bun install",
  "functions": {
    "api/openrouter/[...path].ts": {
      "runtime": "@vercel/node@5.7.15"
    }
  }
}
