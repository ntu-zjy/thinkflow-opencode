# ThinkFlow 云端 OpenCode 服务
FROM oven/bun:1-alpine

RUN apk add --no-cache ripgrep ca-certificates git

WORKDIR /app

# 复制 monorepo 根配置
COPY package.json bun.lock* ./

# 复制所有 workspace 包（bun install 需要完整 workspace 结构）
# 只复制 package.json 先让 bun 解析依赖图
COPY packages/opencode/package.json packages/opencode/
COPY packages/plugin/package.json packages/plugin/
COPY packages/script/package.json packages/script/
COPY packages/sdk/js/package.json packages/sdk/js/
COPY packages/util/package.json packages/util/
# 其余 workspace 声明的包（只需 package.json 占位）
RUN mkdir -p packages/app packages/console/app packages/console/core \
    packages/console/function packages/console/mail packages/console/resource \
    packages/desktop packages/enterprise packages/function packages/slack \
    packages/ui packages/web packages/thinkflow/app packages/thinkflow/desktop && \
    echo '{"name":"placeholder","version":"0.0.0"}' > packages/app/package.json && \
    echo '{"name":"placeholder","version":"0.0.0"}' > packages/console/app/package.json && \
    echo '{"name":"placeholder","version":"0.0.0"}' > packages/console/core/package.json && \
    echo '{"name":"placeholder","version":"0.0.0"}' > packages/console/function/package.json && \
    echo '{"name":"placeholder","version":"0.0.0"}' > packages/console/mail/package.json && \
    echo '{"name":"placeholder","version":"0.0.0"}' > packages/console/resource/package.json && \
    echo '{"name":"placeholder","version":"0.0.0"}' > packages/desktop/package.json && \
    echo '{"name":"placeholder","version":"0.0.0"}' > packages/enterprise/package.json && \
    echo '{"name":"placeholder","version":"0.0.0"}' > packages/function/package.json && \
    echo '{"name":"placeholder","version":"0.0.0"}' > packages/slack/package.json && \
    echo '{"name":"placeholder","version":"0.0.0"}' > packages/ui/package.json && \
    echo '{"name":"placeholder","version":"0.0.0"}' > packages/web/package.json && \
    echo '{"name":"placeholder","version":"0.0.0"}' > packages/thinkflow/app/package.json && \
    echo '{"name":"placeholder","version":"0.0.0"}' > packages/thinkflow/desktop/package.json

# 安装依赖
RUN bun install --frozen-lockfile

# 复制实际源码
COPY packages/opencode/src packages/opencode/src
COPY packages/opencode/tsconfig.json packages/opencode/
COPY packages/plugin/src packages/plugin/src
COPY packages/plugin/tsconfig.json packages/plugin/
COPY packages/script/src packages/script/src
COPY packages/script/tsconfig.json packages/script/
COPY packages/sdk/js/src packages/sdk/js/src
COPY packages/sdk/js/tsconfig.json packages/sdk/js/
COPY packages/util/src packages/util/src
COPY packages/util/tsconfig.json packages/util/

ENV PORT=4096

EXPOSE 4096

CMD ["sh", "-c", "cd packages/opencode && bun run --conditions=browser src/index.ts serve --hostname 0.0.0.0 --port ${PORT} --cors '*'"]
