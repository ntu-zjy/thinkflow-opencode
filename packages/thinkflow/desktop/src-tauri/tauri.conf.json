{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ThinkFlow",
  "version": "0.1.0",
  "identifier": "ai.thinkflow.desktop",
  "mainBinaryName": "thinkflow",
  "build": {
    "beforeDevCommand": "cd ../app && bunx vite --port 1420",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run --cwd ../app build",
    "frontendDist": "../app/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "ThinkFlow · 思流",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": true,
        "transparent": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": null,
      "exceptionDomain": "",
      "signingIdentity": null
    }
  },
  "plugins": {}
}
