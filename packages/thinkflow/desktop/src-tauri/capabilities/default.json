{
  "$schema": "https://schema.tauri.app/schemas/2/capabilities/desktop-schema.json",
  "identifier": "default",
  "description": "ThinkFlow main window capabilities",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "shell:default",
    "dialog:default",
    "store:default",
    "window-state:default",
    "os:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "http://localhost:4096/*" },
        { "url": "http://*" },
        { "url": "https://*" }
      ]
    }
  ]
}
